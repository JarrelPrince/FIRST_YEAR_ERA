import java.util.*;

public class Main {
    public static void main(String[] args) {
      Scanner sc = new Scanner (System.in);
      int[][]sales = new int [3][4];

      for(int i = 0; i < 3; i++){
        for (int j = 0; j < 4; j++){
          System.out.print("Branch " + (i + 1 )  + ", Day " + (j + 1) + ": ");
          sales [i][j] = sc.nextInt();
        }
      }
      System.out.println("\nSales:");
      for (int i = 0; i < 3; i++){
        for(int j= 0; j < 4; j++){
          System.out.print(sales[i][j] + " ");
        }
        System.out.println();
     }

     System.out.println();
      for(int i = 0; i < 3; i++){
        int rowTotal = 0;
        for (int j = 0; j < 4; j++){
          rowTotal = rowTotal + sales[i][j];
        }
        System.out.println("Branch " + (i + 1) + " Total: " + rowTotal);
      }
      for (int j = 0; j<4; j++ ){
        int colTotal = 0;
        for (int i = 0; i < 3; i++){
          colTotal = colTotal + sales[i][j];
        }
        System.out.println("Day "  + (j + 1) + " Total: "+ colTotal);
      }
    
    }
}
